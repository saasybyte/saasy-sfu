# saasy-sfu environment
# Copy to .env for local development. config/default.toml provides defaults,
# so only set what you change.

HTTP_HOST=0.0.0.0
HTTP_PORT=9091

GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_CONCURRENCY_LIMIT=128

# Bind and announce addresses for WebRTC media.
# Local dev: 127.0.0.1 for both. Containers/production: LISTEN_IP_ADDR=0.0.0.0
# and ANNOUNCED_IP_ADDR set to the host's public IP.
LISTEN_IP_ADDR=127.0.0.1
ANNOUNCED_IP_ADDR=127.0.0.1

# Each mediasoup worker binds one UDP port for RTP, starting at 10000.
# With 2 workers, expose UDP 10000-10001.
MEDIASOUP_WORKERS=2
MEDIASOUP_LOG=debug

MAX_SESSIONS_PER_ROUTER=250
SUBSCRIBE_CHANNEL_CAPACITY=128

RUST_LOG=info
